{
  "name": "@feniix/pi-conductor",
  "version": "0.13.0",
  "description": "Archived discontinued experiment: long-lived multi-session worker orchestration for pi with git worktrees, resumable sessions, and PR flows",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "orchestration",
    "worktree",
    "git",
    "session"
  ],
  "type": "module",
  "bin": {
    "pi-conductor-runner": "./extensions/runner-cli.mjs"
  },
  "files": [
    "extensions/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@feniix/worktrees-core": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feniix/pi-conductor.git"
  },
  "author": {
    "name": "Sebastian Otaegui",
    "url": "https://github.com/feniix"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/feniix/pi-conductor/issues"
  },
  "homepage": "https://github.com/feniix/pi-conductor#readme",
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
