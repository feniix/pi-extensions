{
  "name": "pi-packages",
  "version": "2.2.1",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "description": "Extensions for pi, the AI coding agent",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm run lint && pnpm run typecheck",
    "check:ci": "biome ci . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:workspaces": "./scripts/audit-workspaces.sh",
    "ci:detect": "./scripts/detect-ci-packages.sh"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-packages",
    "pi-extensions",
    "pi-coding-agent",
    "extensions",
    "ai"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-devtools/extensions/index.ts",
      "./packages/pi-exa/extensions/index.ts",
      "./packages/pi-notion/extensions/index.ts",
      "./packages/pi-ref-tools/extensions/index.ts",
      "./packages/pi-statusline/extensions/index.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^4.1.2",
    "typebox": "^1.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
